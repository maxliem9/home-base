# Docker image tag pulled from GHCR (images are prebuilt by CI). Default: latest.
# Pin to a commit SHA for a reproducible deploy, e.g. IMAGE_TAG=a1b2c3d.
#IMAGE_TAG=latest

# Database
DB_URL=jdbc:postgresql://db:5432/homebase
DB_USER=homebase
DB_PASSWORD=change_me

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change_me_with_a_long_random_secret

# Fixed users (no self-registration). Format: username:password,username2:password2
# Seeded on every backend startup; changing a password here updates it on next start.
SEED_USERS=max:change_me,partner:change_me

# Household name (sidebar) and digest time used to be set here. They are now edited
# in-app under Einstellungen → Haushalt / Benachrichtigungen and persisted in the
# database (defaults: "Mäxchen" / 20:00). No env var needed. See issue #100.

# Public HTTPS domain of the deployment, e.g. homebase.example.com (no scheme,
# no trailing slash). Used by scripts/deploy.sh to verify a deploy via the health
# endpoint https://<DOMAIN>/api/v1/health, and by the backend to pin the allowed
# browser origin (CORS) to https://<DOMAIN>. Leave blank to skip the health check
# and allow any origin (local dev).
DOMAIN=

# Note images — storage directory (in prod a mounted volume) and per-image size cap in MB.
# Defaults: uploadDir "uploads" (relative to the backend), MAX_UPLOAD_MB 10.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# Trusted reverse-proxy hops in front of the backend, used to find the real client IP in
# X-Forwarded-For for login throttling (issue #8). Default 2 matches the prod chain
# (DSM reverse proxy + nginx web container). Set to 0 if the backend is exposed directly.
# NOTE: 2 only works if the DSM reverse proxy actually records the real client IP in
# X-Forwarded-For (DSM: enable the X-Forwarded-For custom header on the proxy rule). If it
# doesn't, lower this to match the proxies that really append — a wrong value over-throttles
# but never lets a client spoof its way past the limit.
TRUSTED_PROXY_COUNT=2

# Container timezone (optional, default Europe/Berlin). Sets the backend JVM's
# default zone, used by the digest (firing time / day boundaries) and the time
# CSV export (rendered Start/Ende). The in-app digest time is interpreted in this zone.
TZ=Europe/Berlin

# Telegram Digest (optional) — bot credentials only. The send time is set in-app
# (Einstellungen → Benachrichtigungen), not here. Leave blank to disable the digest.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recurring todos: daily time the safety-net rolls overdue recurring todos forward (optional)
RECURRING_TIME=00:30

# Web Push / VAPID (optional, #429 Phase 2b) — browser notifications for todo reminders.
# All three must be set for web push to activate; leave blank to keep it dormant (a
# Telegram-only or no-notification deployment behaves exactly as before). Secrets — env only.
# Generate a VAPID keypair once with the web-push CLI:
#     npx web-push generate-vapid-keys
# (or any P-256 generator). Use the printed Public Key / Private Key below. VAPID_SUBJECT is a
# contact URI the push services can reach you at: mailto:you@example.com or https://your-domain.
# Rotating the keypair invalidates existing browser subscriptions (users re-enable per device).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
