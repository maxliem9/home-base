<?xml version="1.0" encoding="utf-8"?>
<!--
  Default (German) UI strings — the app's base locale and single source of truth for keys.
  English lives in res/values-en/strings.xml with the SAME keys; Android falls back to this
  file for any key missing there, and the in-app switcher (Einstellungen → Sprache) flips
  between them via AppCompatDelegate.setApplicationLocales(...).

  Conventions: keys are grouped by screen (login_, shopping_, todo_, time_, recipe_,
  notes_, absence_, settings_, drawer_, dashboard_) with shared bits under action_/common_.
  Interpolated text uses positional args (%1$s/%1$d); count-dependent wording uses <plurals>.
-->
